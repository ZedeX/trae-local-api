PORT=19900
TRAE_DATA_DIR=
TRAE_EDITION=cn
TRAE_API_HOST=https://trae-api-cn.mchost.guru
TRAE_AUTH_HOST=https://trae-api-cn.mchost.guru
TRAE_MANUAL_TOKEN=
API_KEY=trae-local-api-key
WORKSPACE_DIR=./output
LOG_LEVEL=info
OUTPUT_SYNC_DIR=

# Auto-continue: automatically send continue prompt when model output is truncated
AUTO_CONTINUE=true
MAX_CONTINUES=5

# Trae API hosts per region (used when TRAE_API_HOST/TRAE_AUTH_HOST not set)
# TRAE_HOST_CN=https://trae-api-cn.mchost.guru
# TRAE_HOST_SG=https://coresg-normal.trae.ai
# TRAE_HOST_US=https://coreva-normal.trae.ai

# Optional: Override IDE version (auto-detected from Trae manifest.json)
# TRAE_IDE_VERSION=3.3.67
# TRAE_IDE_VERSION_CODE=20260401

# Optional: Override default device info (auto-detected from Trae IDE storage)
# TRAE_DEVICE_ID=
# TRAE_MACHINE_ID=
# TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8
# TRAE_OAUTH_CLIENT_ID=ono9krqynydwx5
# TRAE_OAUTH_CLIENT_SECRET=-
# TRAE_DEVICE_MODEL=82RF
# TRAE_CPU=Intel
# TRAE_OS_NAME=windows
# TRAE_OS_VERSION=Windows 10

# Optional: Trae CN data directory for fetch-models-vscdb.js
# TRAE_CN_DATA_DIR=C:\Users\<you>\AppData\Roaming\Trae CN

# Proxy settings (uncomment if needed)
# HTTP_PROXY=http://localhost:7891
# HTTPS_PROXY=http://localhost:7891
# ALL_PROXY=socks5://localhost:1083
